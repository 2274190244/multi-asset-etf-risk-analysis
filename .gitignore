# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Virtual environments and build artifacts
.venv/
venv/
build/
dist/
*.egg-info/

# Local secrets and Streamlit credentials
.env
.streamlit/secrets.toml

# Legacy mutable output; the verified evidence package stays tracked
/output/

# Local worktrees and editor files
/.worktrees/
.vscode/
.idea/
.DS_Store
Thumbs.db

.audit_tmp/
.audit_deps/

# Generated research result packages and local test artifacts
/output_verified/
/output_phase*/
/.t*/

# Keep final phase reports, but not generated audit logs, snapshots, or raw responses
/docs/audit/*
!/docs/audit/phase1_report.md
!/docs/audit/phase2_report.md
!/docs/audit/phase3_report.md
!/docs/audit/phase4_report.md
!/docs/audit/phase5_report.md
!/docs/audit/phase6_report.md

# Local implementation-planning artifacts
/docs/superpowers/plans/